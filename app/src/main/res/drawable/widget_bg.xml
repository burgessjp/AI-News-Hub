<?xml version="1.0" encoding="utf-8"?>
<!-- 「今日热点」小组件卡片背景(light):surfaceContainerLow 卡面 + 1dp outlineVariant 描边,
     对齐 App 卡片「描边分层不靠阴影」;16dp 圆角(与 App shapes.medium 语义一致)。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#F1F3FF" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#C3C5D9" />
</shape>
