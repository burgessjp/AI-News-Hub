<?xml version="1.0" encoding="utf-8"?>
<!--
  共用文案(中文全集,默认 locale;英文在 values-en/strings_common.xml)。

  术语表(各 feature 翻译统一遵守):
    总览 Overview / 摘要 Digest / 更多 More / 今日热点 Hot Now / 突发 Breaking /
    AI 日报 AI Daily / 信息源 Sources / 浏览历史 History / 阅读模式 Reader Mode /
    归档 Archive / 设置 Settings / 翻译 Translate / 评论 Comments

  约定:
  - 新增 UI 文案一律先进资源,不在代码里写字面量;中文进 values/,英文进 values-en/。
  - 带变量的串用位置占位符(%1$d / %2$s);英文有单复数的用 plurals(中文只写 other)。
  - date_fmt_* 是 SimpleDateFormat 模式串,按 locale 各写各的。
-->
<resources>
    <!-- ===== 通用动作/状态 ===== -->
    <string name="common_back">返回</string>
    <string name="common_retry">重试</string>
    <string name="common_cancel">取消</string>
    <string name="common_ok">确定</string>
    <string name="common_view">查看</string>
    <string name="common_ignore">忽略</string>
    <string name="common_got_it">我知道了</string>
    <string name="common_loading">加载中…</string>
    <string name="common_load_failed">加载失败</string>
    <string name="common_refresh">刷新</string>
    <string name="common_refresh_hint">下拉或点下方按钮刷新看看</string>
    <string name="common_refresh_once">刷新一下</string>
    <string name="common_empty">暂无内容</string>
    <string name="common_empty_today">今日暂无内容</string>
    <string name="common_no_result">未找到相关内容</string>
    <string name="common_share">分享</string>
    <string name="common_copy">复制</string>
    <string name="common_copied">已复制</string>
    <string name="common_go_settings">去设置</string>
    <string name="common_back_to_top">返回顶部</string>
    <string name="common_all_loaded">已加载全部</string>
    <string name="common_translate_config_missing">请先在 设置 → 翻译 中配置翻译服务</string>
    <!-- 离线兜底:归档取数网络失败但盘上有旧数据时提示一次 -->
    <string name="offline_banner">网络不可用，正在展示缓存数据</string>
    <!-- 下拉刷新后批次未变化:归档一天只更数批,主动说清非实时并给出下一批预期 -->
    <string name="refresh_no_new_batch">已是最新批次 · 数据生成于 %1$s · 下一批 %2$s</string>
    <string name="refresh_no_new_batch_plain">已是最新批次 · 下一批 %1$s</string>
    <!-- 源断供警示:index latest 指针 >24h 未前进 = 该源连续多批抓取失败 -->
    <string name="source_stale_warning">数据已 %1$s 未更新，该源可能暂时断供</string>
    <string name="source_stale_badge">已 %1$s 未更新</string>
    <plurals name="source_stale_days">
        <item quantity="other">%1$d 天</item>
    </plurals>

    <!-- ===== 错误文案(UiState.toUiError 按 ErrorKind 取词) ===== -->
    <string name="error_no_data">今日内容尚未更新,请稍后再试</string>
    <string name="error_network">网络异常,请检查连接后重试</string>
    <string name="error_server">服务暂不可用,请稍后重试</string>
    <string name="error_ai_service">AI 服务暂时不可用,请稍后重试</string>
    <string name="error_ai_auth">AI 服务鉴权失败,请检查 API Key 与服务商设置</string>
    <string name="error_rate_limited">访问受限,请稍后重试</string>
    <string name="error_unknown">加载失败,请稍后重试</string>
    <string name="error_too_short">内容过短</string>

    <!-- ===== 相对时间 / 星期 ===== -->
    <string name="time_just_now">刚刚</string>
    <plurals name="time_minutes_ago">
        <item quantity="other">%1$d 分钟前</item>
    </plurals>
    <plurals name="time_hours_ago">
        <item quantity="other">%1$d 小时前</item>
    </plurals>
    <plurals name="time_days_ago">
        <item quantity="other">%1$d 天前</item>
    </plurals>
    <!-- 无空格紧凑变体(NewsCard 等沿用旧样式) -->
    <plurals name="time_minutes_ago_compact">
        <item quantity="other">%1$d分钟前</item>
    </plurals>
    <plurals name="time_hours_ago_compact">
        <item quantity="other">%1$d小时前</item>
    </plurals>
    <plurals name="time_days_ago_compact">
        <item quantity="other">%1$d天前</item>
    </plurals>
    <string name="time_today">今天</string>
    <string name="time_yesterday">昨天</string>
    <string name="time_day_before_yesterday">前天</string>
    <!-- 周一~周日(SimpleDateFormat "E" 中文会出「星期一」,故保留手工表) -->
    <string-array name="weekdays">
        <item>周一</item>
        <item>周二</item>
        <item>周三</item>
        <item>周四</item>
        <item>周五</item>
        <item>周六</item>
        <item>周日</item>
    </string-array>

    <!-- ===== 日期格式模式(SimpleDateFormat) ===== -->
    <string name="date_fmt_month_day">M月d日</string>
    <string name="date_fmt_month_day_week">M月d日 · E</string>
    <string name="date_fmt_month_day_time">M月d日 HH:mm</string>
    <string name="date_fmt_full">yyyy-MM-dd</string>
    <string name="date_fmt_month_day_dash">MM-dd</string>
    <string name="date_fmt_month_day_time_dash">MM-dd HH:mm</string>

    <!-- ===== 语言设置 ===== -->
    <string name="settings_language">语言</string>
    <string name="language_follow_system">跟随系统</string>
    <string name="language_zh">简体中文</string>
    <string name="language_en">English</string>

    <!-- ===== 枚举展示名 ===== -->
    <string name="provider_deepseek">DeepSeek</string>
    <string name="provider_zhipu_glm">智谱 GLM</string>
    <string name="provider_custom">自定义</string>
