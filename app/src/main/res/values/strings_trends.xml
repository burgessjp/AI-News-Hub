    <string name="trends_error_load_failed">趋势加载失败,请稍后重试</string>
    <!-- 顶部时效 caption:%1$d=窗口天数,%2$s=数据截至日期(如 8月9日) -->
    <string name="trends_window_caption">近 %1$d 天热词 · 数据截至 %2$s</string>
