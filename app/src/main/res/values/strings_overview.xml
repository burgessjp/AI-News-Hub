<?xml version="1.0" encoding="utf-8"?>
<!-- 总览 Tab 文案(中文全集,默认 locale;英文在 values-en/strings_overview.xml)。 -->
<resources>
    <!-- 加载中说明(AI 长输出,避免用户误以为卡死) -->
    <string name="overview_loading">正在加载今日总览…</string>
    <!-- 空态:归档 latest_overview 字段缺失 -->
    <string name="overview_no_data_title">今日总览尚未生成</string>
    <string name="overview_no_data_subtitle">今天的内容还在准备中,请稍后再来</string>
    <!-- 错误态标题 -->
    <string name="overview_load_failed">总览加载失败</string>
    <!-- breaking 标签(日刊语义:本批权重最高、排最前的条目;内联在标题行首) -->
    <string name="overview_breaking_tag">头条</string>
    <!-- 「今天」页 Top10 区块小节条 -->
    <string name="today_focus_section">今日重点</string>
    <!-- 「今天」页分源摘要区块头右侧「查看全部」文字链(正文链 + 计数) -->
    <plurals name="today_source_view_all">
        <item quantity="other">查看全部 %1$d 条</item>
    </plurals>
    <!-- 源摘要条目数为 0 时的不带计数变体 -->
    <string name="today_source_view_all_plain">查看全部</string>
    <!-- 长综述折叠的展开/收起按钮(仅溢出时渲染) -->
    <string name="overview_digest_expand">展开</string>
    <string name="overview_digest_collapse">收起</string>

    <!-- 页脚:生成时间 / 数据截至 / 源计数 / 缺源标注(段间「 · 」为标点,两语言一致,留代码) -->
    <string name="overview_generated_at">生成于 %1$s</string>
    <string name="overview_data_until">数据截至 %1$s</string>
    <plurals name="overview_based_on_sources">
        <item quantity="other">基于 %1$d 源当日内容</item>
    </plurals>
    <string name="overview_missing_sources">缺 %1$s</string>
    <!-- 缺源列表连接符(中文顿号;英文用逗号) -->
    <string name="overview_list_separator">、</string>

    <!-- ViewModel 错误文案(网络/受限复用 common error_*) -->
    <string name="overview_error_parse">数据解析失败,请稍后重试</string>
    <string name="overview_error_load_failed">总览加载失败,请稍后重试</string>

    <!-- 历史总览(「更多 → 历史总览」两级页) -->
    <string name="overview_archive_title">历史总览</string>
    <string name="overview_archive_load_failed">历史总览加载失败</string>
    <string name="overview_archive_empty_title">暂无历史总览</string>
    <string name="overview_archive_empty_subtitle">每日总览生成后按日归档\n可回看最近 90 天</string>
    <string name="overview_date_title">%1$s 总览</string>
</resources>
