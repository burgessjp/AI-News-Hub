    <string name="settings_daily_notify_hint_samsung">Not receiving notifications? Add this app to \"Never sleeping apps\" (Settings → Battery → Background usage limits)</string>
    <string name="settings_daily_notify_hint_oem">Not receiving notifications? Allow this app to run in the background (autostart) in system settings</string>
    <string name="settings_daily_notify_permission_denied">Notification permission not granted. Please allow notifications in system settings</string>

    <!-- ===== Notification body ===== -->
    <string name="notify_daily_channel_name">Daily updates</string>
    <string name="notify_daily_title">Today\'s highlights are ready</string>
    <string name="notify_daily_text_fallback">Today\'s Top 10 is ready. Tap to read.</string>
</resources>
