<?xml version="1.0" encoding="utf-8"?>
<!-- Daily update notification (English). See values/strings_notify.xml for the feature pointer. -->
<resources>
    <!-- ===== Settings entry ===== -->
    <string name="settings_section_notify">Notifications</string>
    <string name="settings_daily_notify">Daily update notification</string>
    <string name="settings_daily_notify_subtitle">Get notified when today\'s highlights are ready (at most once a day, local schedule)</string>
    <!-- Appended to the subtitle when enabled: last self-check run time (troubleshooting) -->
    <string name="settings_daily_notify_last_check">Last check: %1$s</string>
