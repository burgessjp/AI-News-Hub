<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 网页下载:API<29 经 DownloadManager 写公共「下载」目录需要;API 29+ scoped storage 无需 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 网页唤起外部 App:Android 11+ 需声明 <queries> 才能 resolveActivity
         判断目标 App 是否存在(intent:// 及普通自定义 scheme)。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="intent" />
        </intent>
        <!-- 通用 scheme:补全可见性,使 resolveActivity 在 Android 11+ 正常工作 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>
    <!-- 预测返回手势:Android 13/14 开启「退回桌面」预览动画;Android 15+ 默认 true。
         App 全程 OnBackPressedDispatcher(BackHandler/PredictiveBackHandler),与该模式兼容。 -->
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 系统选中菜单「译」:声明 PROCESS_TEXT 后,系统 ActionMode 自动把 label「译」
             作为菜单项加入;点击时通过 EXTRA_PROCESS_TEXT 传入选中文本。
             exported=true 必须(系统跨进程拉起);透明主题避免闪全屏白底。 -->
        <activity
            android:name=".ui.translate.TranslateSelectionActivity"
            android:exported="true"
            android:label="译"
            android:theme="@style/AppTheme.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
