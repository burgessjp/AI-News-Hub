<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 每日更新通知:API 33+ 需在运行时经设置页开关请求,见 notify/DailyUpdateNotifier.kt -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 网页下载:API<29 经 DownloadManager 写公共「下载」目录需要;API 29+ scoped storage 无需 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 应用内更新直装:Android 8+ 拉起系统安装器装下载好的 APK 需要此权限,
         首次安装前用户还需在系统设置为本 App 开「安装未知应用」(见 data/UpdateDownloader.kt) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 语音速报前台服务:FOREGROUND_SERVICE(API 28+)与 mediaPlayback 类型
         (targetSdk 34+ 强制),见 playback/TtsPlaybackService.kt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 更新后台下载前台服务:dataSync 类型(targetSdk 34+ 强制),
         见 data/net/UpdateDownloadService.kt -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- 网页唤起外部 App:Android 11+ 需声明 <queries> 才能 resolveActivity
         判断目标 App 是否存在(intent:// 及普通自定义 scheme)。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="intent" />
        </intent>
        <!-- 通用 scheme:补全可见性,使 resolveActivity 在 Android 11+ 正常工作 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>
    <!-- 预测返回手势:Android 13/14 开启「退回桌面」预览动画;Android 15+ 默认 true。
         App 全程 OnBackPressedDispatcher(BackHandler/PredictiveBackHandler),与该模式兼容。 -->
    <!-- Application 入口:初始化归档磁盘缓存等无 Activity 依赖的全局组件 -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- singleTask:单 Activity 架构,桌面小组件点击把既有任务带回前台走 onNewIntent,
             避免每次点击都新开 Activity 实例 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 外部深链:自定义 scheme(浏览器/二维码/自动化工具经此直达 App 内页面)。
                 路由见 MainActivity 的 ainewshub:// 解析:web / tab / settings。
                 不做 https App Links(需 assetlinks 验证,当前分发不上商店无收益)。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ainewshub" />
            </intent-filter>
        </activity>

        <!-- 应用内更新直装:把 cacheDir/updates/ 下的 APK 以 content:// 授给系统安装器
             (Android 7+ 禁止 file:// 直发),authority 见 file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 「今日热点」桌面小组件(Glance):只处理系统 APPWIDGET_UPDATE 广播 -->
        <receiver
            android:name=".widget.HotNowWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_hot_now_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hot_now_widget_info" />
        </receiver>

        <!-- 语音速报前台服务(TextToSpeech 朗读 + 通知栏控制):
             仅前台 UI 点击启动(exported=false);mediaPlayback 类型为
             targetSdk 34+ 强制声明,配套权限见上方 uses-permission 注释 -->
        <service
            android:name=".playback.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 更新后台下载前台服务(通知栏进度 + 完成点击安装):
             仅前台 UI 点击启动(exported=false);dataSync 类型为
             targetSdk 34+ 强制声明,配套权限见上方 uses-permission 注释 -->
        <service
            android:name=".data.net.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 系统选中菜单「译」:声明 PROCESS_TEXT 后,系统 ActionMode 自动把 label「译」
             作为菜单项加入;点击时通过 EXTRA_PROCESS_TEXT 传入选中文本。
             exported=true 必须(系统跨进程拉起);透明主题避免闪全屏白底。 -->
        <activity
            android:name=".ui.translate.TranslateSelectionActivity"
            android:exported="true"
            android:label="@string/translate_label"
            android:theme="@style/AppTheme.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
